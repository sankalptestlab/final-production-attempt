# Environment Variables for Production Deployment

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Anthropic API (for Francis - Claude AI)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# n8n Webhook URL (for CAM processing workflow)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/cam-build-trigger

# External API Keys (for production - replace mocks)
# GST API
GST_API_URL=https://api.gst.gov.in
GST_API_KEY=your-gst-api-key

# Credit Bureau API
CREDIT_BUREAU_API_URL=https://api.creditbureau.com
CREDIT_BUREAU_API_KEY=your-bureau-api-key

# FameScore API
FAMESCORE_API_URL=https://api.famescore.in
FAMESCORE_API_KEY=your-famescore-api-key

# PAN Verification API
PAN_API_URL=https://api.pan.gov.in
PAN_API_KEY=your-pan-api-key

# Udyam API
UDYAM_API_URL=https://udyamregistration.gov.in/api
UDYAM_API_KEY=your-udyam-api-key

# Logging
LOG_LEVEL=INFO

# Security
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Application Settings
MAX_CONVERSATION_LENGTH=50
SESSION_TIMEOUT_MINUTES=30
