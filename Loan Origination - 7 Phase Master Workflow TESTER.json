        "jsCode": "const lenders = $input.item.json.lenders || [];\nconst ranked = lenders.map(l => {\n  const lenderData = l;\n  return {\n    ...lenderData,\n    expectedValue: (l.commission || 0) * (l.approval_probability || 0.5),\n    approvalProb: l.approval_probability || 0.5\n  };\n}).sort((a, b) => b.expectedValue - a.expectedValue);\nreturn [{json: {recommended: ranked[0], alternatives: ranked.slice(1, 3), all_lenders: ranked}}];"
