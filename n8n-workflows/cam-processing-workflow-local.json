{
  "name": "CAM Processing Workflow (Local)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-cam-build",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - CAM Build Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "cam-build-trigger"
    },
    {
      "parameters": {
        "functionCode": "// Extract data from Francis webhook\nconst conversationId = $input.item.json.conversation_id;\nconst customerId = $input.item.json.customer_id;\nconst extractedData = $input.item.json.extracted_data;\n\nreturn {\n  json: {\n    conversation_id: conversationId,\n    customer_id: customerId,\n    gstin: extractedData.gstin,\n    pan: extractedData.pan,\n    consent_obtained: extractedData.consent_obtained,\n    loan_amount_lakhs: extractedData.loan_amount_lakhs,\n    loan_purpose: extractedData.loan_purpose,\n    tenure_months: extractedData.tenure_months,\n    collateral_available: extractedData.collateral_available,\n    customer_priority: extractedData.customer_priority\n  }\n};"
      },
      "id": "extract-params",
      "name": "Extract Parameters",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8001/famescore-report",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "gstin",
              "value": "={{ $json.gstin }}"
            },
            {
              "name": "pan",
              "value": "={{ $json.pan }}"
            },
            {
              "name": "include_bureau",
              "value": true
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "call-famescore",
      "name": "Call FameScore API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 200]
    },
    {
      "parameters": {
        "url": "http://localhost:8001/pull-credit-bureau",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "entity_pan",
              "value": "={{ $json.pan }}"
            },
            {
              "name": "consent_obtained",
              "value": "={{ $json.consent_obtained }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "call-commercial-bureau",
      "name": "Call Commercial Credit Bureau",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8001/verify-gst",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "gstin",
              "value": "={{ $json.gstin }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "call-gst-lookup",
      "name": "GST Basic Lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 400]
    },
    {
      "parameters": {
        "url": "http://localhost:8001/lookup-udyam",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "pan",
              "value": "={{ $json.pan }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "call-udyam-lookup",
      "name": "Udyam Lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 500]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll"
      },
      "id": "merge-data",
      "name": "Merge All Data Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "functionCode": "// Combine all data sources into Nikita request format\nconst items = $input.all();\nconst originalParams = items[0].json;\nconst fameScoreData = items[1]?.json?.data || {};\nconst creditBureauData = items[2]?.json?.data || {};\nconst gstData = items[3]?.json?.data || {};\nconst udyamData = items[4]?.json?.data || {};\n\nreturn {\n  json: {\n    conversation_id: originalParams.conversation_id,\n    gst_data: fameScoreData,\n    pan_data: { pan: originalParams.pan },\n    credit_bureau: creditBureauData,\n    udyam_data: udyamData,\n    customer_inputs: {\n      loan_amount_requested: originalParams.loan_amount_lakhs,\n      loan_purpose: originalParams.loan_purpose,\n      tenure_preference_months: originalParams.tenure_months || 36,\n      collateral_available: originalParams.collateral_available,\n      priority: originalParams.customer_priority || 'low_interest'\n    }\n  }\n};"
      },
      "id": "format-nikita-request",
      "name": "Format Nikita Request",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8002/build-cam",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "call-nikita",
      "name": "Call Nikita - Build CAM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "functionCode": "// Format data for Kesha assessment\nconst camResponse = $input.item.json;\nconst camData = camResponse.cam_data || {};\n\nreturn {\n  json: {\n    cam_id: camResponse.cam_id,\n    conversation_id: camData.conversation_id,\n    business_profile: {\n      vintage_years: camData.business_profile?.years_in_business || 3,\n      industry: camData.business_profile?.industry_sector || 'IT_services'\n    },\n    financial_metrics: {\n      annual_turnover_lakhs: camData.financial_summary?.turnover?.annual_lakhs || 2400,\n      profit_margin: camData.financial_summary?.profitability?.net_profit_margin_pct / 100 || 0.15,\n      turnover_growth_yoy: 0.17\n    },\n    credit_profile: {\n      commercial_score: camData.credit_profile?.commercial_bureau?.score || 'CMR-2',\n      existing_facilities: camData.credit_profile?.existing_facilities || [],\n      active_loans_count: camData.credit_profile?.commercial_bureau?.active_loans || 3,\n      utilization_pct: 0.75,\n      overdue_amount_lakhs: camData.credit_profile?.commercial_bureau?.overdue_amount_lakhs || 0\n    },\n    compliance: {\n      filing_consistency: 0.92\n    },\n    loan_request: camData.loan_request || { amount_lakhs: 50, tenure_months: 36 },\n    customer_preferences: camData.customer_preferences || { priority: 'low_interest' }\n  }\n};"
      },
      "id": "format-kesha-request",
      "name": "Format Kesha Request",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8003/assess",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "call-kesha",
      "name": "Call Kesha - Assess & Match",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "functionCode": "// Format final response\nconst assessment = $input.item.json;\n\nreturn {\n  json: {\n    success: true,\n    assessment_id: assessment.assessment_id,\n    overall_eligibility: assessment.overall_eligibility,\n    max_eligible_amount_lakhs: assessment.max_eligible_amount_lakhs,\n    top_lenders: assessment.lender_matches.slice(0, 3).map(l => ({\n      name: l.lender_name,\n      amount: l.eligible_amount_lakhs,\n      rate: l.interest_rate_range,\n      probability: l.approval_probability\n    })),\n    customer_report: assessment.customer_report\n  }\n};"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1850, 300]
    }
  ],
